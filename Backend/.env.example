# ── LLM — DeepSeek V3.2 ───────────────────────────────
# Obtener en: platform.deepseek.com → API Keys
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Seguridad ─────────────────────────────────────────
# Token secreto que el plugin de Moodle enviará en cada petición
# Generar con: python -c "import secrets; print(secrets.token_hex(32))"
API_TOKEN=genera_un_token_aleatorio_aqui

# ── Base de conocimiento ──────────────────────────────
CHROMA_DB_PATH=./chroma_db

# ── Control de acceso — Piloto controlado ─────────────
# IDs de cursos de Moodle habilitados (ver URL del curso: ?id=N)
# Lista vacía = acceso denegado a todos (comportamiento por defecto)
ALLOWED_COURSE_IDS=[12, 15, 23]

# Nombres exactos de carreras habilitadas
# Deben coincidir con el campo de perfil 'carrera' en Moodle
ALLOWED_CAREERS=["Ingeniería en Sistemas","Ingeniería Industrial"]

# ── Moodle (opcional, si el backend consulta la API de Moodle) ──
MOODLE_URL=https://moodle.miinstituto.edu
MOODLE_API_TOKEN=token_generado_en_moodle
